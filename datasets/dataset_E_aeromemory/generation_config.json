    "corrosion_accelerating",
    "corrosion_stable",
    "corrosion_new",
    "corrosion_resolved",
    "dent_size_progression",
    "dent_depth_progression",
    "dent_stable",
    "dent_repair",
    "missing_fastener_new",
    "missing_fastener_stable",
    "missing_fastener_repaired",
    "mixed_progression",
    "mixed_new_defects",
    "multi_defect_stable",
    "multi_defect_progression",
    "camera_variation",
    "nearby_decoy_region"
  ],
  "source_dataset": "datasets\\master_dataset_ABC",
  "source_read_only": true,
  "not_for_yolo_training": true
